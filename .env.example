# Only the scripts in scripts/ need this file; the web app needs no keys.
# Wallet backup exported from the Portaldot/SubWallet app, saved as wallet.keystore.json (git-ignored).
# Leave empty for ./wallet.keystore.json
KEYSTORE_FILE=
# The backup's password. Wrap it in quotes if it contains # or spaces
KEYSTORE_PASSWORD=
EXPECTED_ADDRESS=
# Leave empty for the public Portaldot V3 testnet endpoints
WS_URL=
EVM_RPC=
# Optional, for scripts/check-pinata.mjs
PINATA_JWT=
PINATA_GATEWAY=
